# 데이터 소스 선택. 비워 두면 mock(로컬 샘플 데이터)을 사용한다.
# mock: 1단계 로컬 목업 / firebase: Firestore 연결
VITE_DATA_MODE=

# firebase 모드에서 사용할 Firebase 웹 앱 설정.
# Firebase 콘솔 > 프로젝트 설정 > 내 앱 > 웹 앱에서 복사한다.
# 이 값들은 비밀키가 아니라 공개 식별자이며, 실제 보호는 보안 규칙이 담당한다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# 로컬 에뮬레이터에 연결하려면 1로 둔다(실제 프로젝트 데이터에 쓰지 않는다).
VITE_USE_FIREBASE_EMULATORS=
